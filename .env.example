# Copy this file to .env.local and fill in the values.
# Never commit .env.local. On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL  (just https://xxxx.supabase.co, nothing after it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → anon public (Legacy API keys tab)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API Keys → service_role (secret). Server only, never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random text of 32+ characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-characters

# true = show the sign-in code on screen instead of sending it on WhatsApp.
# Use only while WhatsApp isn't set up yet; set to false (or remove) before real parents use the app.
OTP_TEST_MODE=true

# WhatsApp Cloud API (Meta) – fill in once your account and template are approved
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=darb_login_code
# WHATSAPP_TEMPLATE_LANG=ar
# WHATSAPP_TEMPLATE_NEXT=darb_bus_next
# WHATSAPP_TEMPLATE_10MIN=darb_bus_10min
