# Copy this file to .env.local and fill in the values.
# Never commit .env.local. On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL  (just https://xxxx.supabase.co, nothing after it)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → anon public (Legacy API keys tab)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API Keys → service_role (secret). Server only, never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random text of 32+ characters. Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-64-random-characters

# Phone notifications for bus alerts. Generate the two keys once with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:you@example.com

# true = show test helpers (the crew app's "simulate driving" button). Remove for real trips.
SHOW_TEST_TOOLS=true
